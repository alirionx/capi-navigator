exports[`CRD generation (STATE-02) > generates the NavigatorUser schema from Zod 1`] = `
"# Generated from packages/shared/src/crds by \`pnpm crds:generate\`. Do not edit.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: navigatorusers.navigator.capi-navigator.io
  labels:
    app.kubernetes.io/part-of: capi-navigator
spec:
  group: navigator.capi-navigator.io
  names:
    kind: NavigatorUser
    listKind: NavigatorUserList
    plural: navigatorusers
    singular: navigatoruser
    shortNames:
      - navuser
    categories:
      - capi-navigator
  scope: Namespaced
  versions:
    - name: v1alpha1
      served: true
      storage: true
      additionalPrinterColumns:
        - name: Roles
          type: string
          jsonPath: .spec.bindings[*].role
        - name: Disabled
          type: boolean
          jsonPath: .spec.disabled
        - name: Age
          type: date
          jsonPath: .metadata.creationTimestamp
      schema:
        openAPIV3Schema:
          type: object
          required:
            - spec
          properties:
            apiVersion:
              type: string
            kind:
              type: string
            metadata:
              type: object
            spec:
              type: object
              properties:
                role:
                  type: string
                  enum:
                    - viewer
                    - operator
                    - admin
                bindings:
                  maxItems: 50
                  type: array
                  items:
                    type: object
                    properties:
                      role:
                        type: string
                        minLength: 2
                        maxLength: 40
                        pattern: ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$
                      connections:
                        minItems: 1
                        type: array
                        items:
                          type: string
                          minLength: 1
                          maxLength: 63
                      namespaces:
                        minItems: 1
                        type: array
                        items:
                          type: string
                          maxLength: 63
                          pattern: ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$
                    required:
                      - role
                disabled:
                  default: false
                  type: boolean
                apiOnly:
                  default: false
                  type: boolean
                mustChangePassword:
                  default: false
                  type: boolean
                sessionGeneration:
                  default: 0
                  type: integer
                  minimum: 0
"
`;

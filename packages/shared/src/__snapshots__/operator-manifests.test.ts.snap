exports[`provider manifests (FP3-F-09, FP3-F-10) > core provider: namespace + CoreProvider 1`] = `
"apiVersion: v1
kind: Namespace
metadata:
  name: capi-system
  labels:
    capi-navigator.io/managed-by: capi-navigator
---
apiVersion: operator.cluster.x-k8s.io/v1alpha2
kind: CoreProvider
metadata:
  name: cluster-api
  namespace: capi-system
  labels:
    capi-navigator.io/managed-by: capi-navigator
spec:
  version: v1.14.3
"
`;

exports[`provider manifests (FP3-F-09, FP3-F-10) > infrastructure provider with variables, feature gates and fetchConfig 1`] = `
"apiVersion: v1
kind: Namespace
metadata:
  name: capo-system
  labels:
    capi-navigator.io/managed-by: capi-navigator
---
apiVersion: v1
kind: Secret
metadata:
  name: openstack-infrastructure-variables
  namespace: capo-system
  labels:
    capi-navigator.io/managed-by: capi-navigator
type: Opaque
stringData:
  EXP_CLUSTER_RESOURCE_SET: "true"
  SECRET_VALUE: s3cr3t
---
apiVersion: operator.cluster.x-k8s.io/v1alpha2
kind: InfrastructureProvider
metadata:
  name: openstack
  namespace: capo-system
  labels:
    capi-navigator.io/managed-by: capi-navigator
spec:
  version: v0.15.0
  configSecret:
    name: openstack-infrastructure-variables
    namespace: capo-system
  manager:
    featureGates:
      MachinePool: true
      PriorityQueue: false
  fetchConfig:
    url: https://example.com/infrastructure-components.yaml
"
`;

exports[`all-in-one with three or five nodes (FP-26) > k0s: three schedulable control plane nodes, no workers (FP26-F-01) 1`] = `
"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: aio-k0s
  namespace: team-a
  labels:
    capi-navigator.io/ccm: openstack
    capi-navigator.io/csi: openstack
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: aio-k0s
  annotations:
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"infrastructure":{"apiServerLoadBalancer":true,"credentialRef":"infomaniak","externalNetwork":"0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d","image":"6f1b2a3c-0d4e-4f5a-8b6c-7d8e9fa0b1c2","network":{"dnsNameservers":["1.1.1.1","8.8.8.8"],"nodeCidr":"10.6.0.0/24"},"provider":"openstack","zoneBoundVolumes":true},"kubernetes":{"flavor":"k0s","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.8+k0s.1"},"name":"aio-k0s","namespace":"team-a","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"a4-ram8-disk50-perf1","replicas":3},"mode":"all-in-one","workerPools":[]}}'
spec:
  clusterNetwork:
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:
        - 10.43.0.0/16
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: K0sControlPlane
    name: aio-k0s-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: OpenStackCluster
    name: aio-k0s
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackCluster
metadata:
  name: aio-k0s
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: aio-k0s
spec:
  identityRef:
    type: ClusterIdentity
    name: infomaniak
    cloudName: infomaniak
  externalNetwork:
    id: 0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d
  managedSubnets:
    - cidr: 10.6.0.0/24
      dnsNameservers:
        - 1.1.1.1
        - 8.8.8.8
  managedSecurityGroups:
    allowAllInClusterTraffic: true
    controlPlaneNodesSecurityGroupRules:
      - name: nodeport-tcp
        description: Kubernetes NodePort services (TCP)
        direction: ingress
        etherType: IPv4
        protocol: tcp
        portRangeMin: 30000
        portRangeMax: 32767
        remoteIPPrefix: 0.0.0.0/0
      - name: nodeport-udp
        description: Kubernetes NodePort services (UDP)
        direction: ingress
        etherType: IPv4
        protocol: udp
        portRangeMin: 30000
        portRangeMax: 32767
        remoteIPPrefix: 0.0.0.0/0
  apiServer:
    managedLoadBalancer:
      enabled: true
      additionalPorts:
        - 8132
        - 9443
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackMachineTemplate
metadata:
  name: aio-k0s-cp-38abfb98
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: aio-k0s
spec:
  template:
    spec:
      flavor:
        filter:
          name: a4-ram8-disk50-perf1
      image:
        id: 6f1b2a3c-0d4e-4f5a-8b6c-7d8e9fa0b1c2
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: K0sControlPlane
metadata:
  name: aio-k0s-control-plane
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: aio-k0s
spec:
  version: v1.35.8+k0s.1
  replicas: 3
  updateStrategy: Recreate
  machineTemplate:
    infrastructureRef:
      apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
      kind: OpenStackMachineTemplate
      name: aio-k0s-cp-38abfb98
      namespace: team-a
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: OpenStackMachineTemplate
        name: aio-k0s-cp-38abfb98
  k0sConfigSpec:
    k0s:
      apiVersion: k0s.k0sproject.io/v1beta1
      kind: ClusterConfig
      metadata:
        name: k0s
      spec:
        api:
          extraArgs:
            anonymous-auth: "true"
        network:
          provider: calico
          calico:
            mode: vxlan
          podCIDR: 10.42.0.0/16
          serviceCIDR: 10.43.0.0/16
        telemetry:
          enabled: false
    args:
      - --enable-worker
      - --no-taints
      - --enable-cloud-provider
      - --kubelet-root-dir=/var/lib/kubelet
    useSystemHostname: true
---
apiVersion: addons.cluster.x-k8s.io/v1beta2
kind: ClusterResourceSet
metadata:
  name: aio-k0s-cloud-config
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: aio-k0s
spec:
  clusterSelector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: aio-k0s
  resources:
    - kind: Secret
      name: aio-k0s-cloud-config
  strategy: Reconcile
"
`;


            name: kube-vip
            namespace: kube-system
          spec:
            containers:
              - name: kube-vip
                image: ghcr.io/kube-vip/kube-vip:v1.3.1
                imagePullPolicy: IfNotPresent
                args:
                  - manager
                env:

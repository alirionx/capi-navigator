exports[`Proxmox VE transformation snapshots (FP31-F-06, FP31-F-07) > RKE2 all-in-one 1`] = `
"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: pve-aio
  namespace: proxmox
  labels:
    capi-navigator.io/ccm: proxmox
    capi-navigator.io/csi: proxmox
    capi-navigator.io/proxmox-storage: local-zfs
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: pve-aio
  annotations:
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"infrastructure":{"apiEndpoint":"10.20.0.89","bootDisk":"virtio0","bridge":"vmbr0","credentialRef":"homelab","image":"7112","memoryAdjustment":0,"network":{"addresses":["10.20.0.71-10.20.0.88"],"dnsNameservers":["1.1.1.1","8.8.8.8"],"gateway":"10.20.0.1","nodeCidr":"10.20.0.0/24"},"provider":"proxmox","sourceNode":"homeserver","storage":"local-zfs"},"kubernetes":{"flavor":"rke2","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.9+rke2r1"},"name":"pve-aio","namespace":"proxmox","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"medium","replicas":1},"mode":"all-in-one","workerPools":[]}}'
spec:
  clusterNetwork:
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:
        - 10.43.0.0/16
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: RKE2ControlPlane
    name: pve-aio-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: ProxmoxCluster
    name: pve-aio
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha2
kind: ProxmoxCluster
metadata:
  name: pve-aio
  namespace: proxmox
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: pve-aio
  annotations:
    capi-navigator.io/credential: homelab
spec:
  controlPlaneEndpoint:
    host: 10.20.0.89
    port: 6443
  ipv4Config:
    addresses:
      - 10.20.0.71-10.20.0.88
    prefix: 24
    gateway: 10.20.0.1
  dnsServers:
    - 1.1.1.1
    - 8.8.8.8
  allowedNodes:
    - homeserver
  schedulerHints:
    memoryAdjustment: 0
  credentialsRef:
    name: pve-aio-proxmox-credentials
    namespace: proxmox
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha2
kind: ProxmoxMachineTemplate
metadata:
  name: pve-aio-cp-986480ec
  namespace: proxmox
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: pve-aio
spec:
  template:
    spec:
      sourceNode: homeserver
      templateID: 7112
      full: true
      storage: local-zfs
      numSockets: 1
      numCores: 4
      memoryMiB: 8192
      disks:
        bootVolume:
          disk: virtio0
          sizeGb: 40
      network:
        networkDevices:
          - name: net0
            bridge: vmbr0
            model: virtio
            defaultIPv4: true
      tags:
        - capi-navigator
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: RKE2ControlPlane
metadata:
  name: pve-aio-control-plane
  namespace: proxmox
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: pve-aio
spec:
  version: v1.35.9+rke2r1
  replicas: 1
  registrationMethod: internal-first
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: ProxmoxMachineTemplate
        name: pve-aio-cp-986480ec
  rolloutStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
  serverConfig:
    cni: calico
    cloudProviderName: external
    disableComponents:
      kubernetesComponents:
        - cloudController
    tlsSan:
      - 10.20.0.89
  agentConfig:
    nodeName: "{{ v1.local_hostname }}"
    kubelet:
      extraArgs:
        - provider-id=proxmox://{{ v1.instance_id }}
  preRKE2Commands:
    - if command -v apt-get >/dev/null; then apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q qemu-guest-agent; elif command -v dnf >/dev/null; then dnf install -y qemu-guest-agent; fi; systemctl enable --now qemu-guest-agent || true
    - if grep -qE '^ID_LIKE=.*(rhel|fedora)' /etc/os-release && grep -qE '^VERSION_ID="?10' /etc/os-release; then dnf install -y kernel-modules-extra; fi
  gzipUserData: false
  files:
    - path: /var/lib/rancher/rke2/server/manifests/kube-vip.yaml
      content: |
        apiVersion: apps/v1
        kind: DaemonSet
        metadata:
          name: kube-vip-ds
          namespace: kube-system
          labels:
            app.kubernetes.io/name: kube-vip-ds
        spec:
          selector:
            matchLabels:
              app.kubernetes.io/name: kube-vip-ds
          template:
            metadata:
              labels:
                app.kubernetes.io/name: kube-vip-ds
            spec:
              affinity:
                nodeAffinity:
                  requiredDuringSchedulingIgnoredDuringExecution:
                    nodeSelectorTerms:
                      - matchExpressions:
                          - key: node-role.kubernetes.io/control-plane
                            operator: Exists
              containers:
                - name: kube-vip
                  image: ghcr.io/kube-vip/kube-vip:v1.3.1
                  imagePullPolicy: IfNotPresent
                  args:
                    - manager
                  env:
                    - name: vip_arp
                      value: "true"
                    - name: port
                      value: "6443"
                    - name: vip_nodename
                      valueFrom:
                        fieldRef:
                          fieldPath: spec.nodeName
                    - name: vip_subnet
                      value: "32"
                    - name: dns_mode
                      value: first
                    - name: dhcp_mode
                      value: ipv4
                    - name: cp_enable
                      value: "true"
                    - name: cp_namespace
                      value: kube-system
                    - name: svc_enable
                      value: "false"
                    - name: vip_leaderelection
                      value: "true"
                    - name: vip_leasename
                      value: plndr-cp-lock
                    - name: vip_leaseduration
                      value: "15"
                    - name: vip_renewdeadline
                      value: "10"
                    - name: vip_retryperiod
                      value: "2"
                    - name: address
                      value: 10.20.0.89
                    - name: prometheus_server
                      value: :2112
                  securityContext:
                    capabilities:
                      add:
                        - NET_ADMIN
                        - NET_RAW
                      drop:
                        - ALL
                  volumeMounts:
                    - name: kubeconfig
                      mountPath: /etc/kubernetes/admin.conf
              hostNetwork: true
              tolerations:
                - effect: NoSchedule
                  operator: Exists
                - effect: NoExecute
                  operator: Exists
              hostAliases:
                - ip: 127.0.0.1
                  hostnames:
                    - kubernetes
              volumes:
                - name: kubeconfig
                  hostPath:
                    path: /etc/rancher/rke2/rke2.yaml
      permissions: "0644"
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDrainRule
metadata:
  name: pve-aio-skip-tigera-operator
  namespace: proxmox
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: pve-aio
spec:
  drain:
    behavior: Skip
  machines:
    - clusterSelector:
        matchLabels:
          cluster.x-k8s.io/cluster-name: pve-aio
  pods:
    - selector:
        matchLabels:
          k8s-app: tigera-operator
      namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: tigera-operator
---
apiVersion: addons.cluster.x-k8s.io/v1beta2
kind: ClusterResourceSet
metadata:
  name: pve-aio-proxmox-cloud-config
  namespace: proxmox
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: pve-aio
spec:
  clusterSelector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: pve-aio
  resources:
    - kind: Secret
      name: pve-aio-proxmox-cloud-config
  strategy: Reconcile
"
`;


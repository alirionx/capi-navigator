            sha256sum -c "\${ctr}.sha256sum"
            tar -C /usr/local -xzf "\${ctr}"
            curl -fsSLO "\${DOWNLOADS}/opencontainers/runc/releases/download/v\${RUNC_VERSION}/runc.\${ARCH}"
            curl -fsSLO "\${DOWNLOADS}/opencontainers/runc/releases/download/v\${RUNC_VERSION}/runc.sha256sum"
            grep " runc.\${ARCH}\\$" runc.sha256sum | sha256sum -c
            install -m 0755 "runc.\${ARCH}" /usr/local/sbin/runc
            cd /
            rm -rf "$tmp"
            cat > /etc/systemd/system/containerd.service <<'UNIT'
            [Unit]
            Description=containerd container runtime
            After=network.target local-fs.target dbus.service

            [Service]
            ExecStartPre=-/sbin/modprobe overlay
            ExecStart=/usr/local/bin/containerd
            Type=notify
            Delegate=yes
            KillMode=process
            Restart=always
            RestartSec=5
            LimitNPROC=infinity
            LimitCORE=infinity
            TasksMax=infinity
            OOMScoreAdjust=-999

            [Install]
            WantedBy=multi-user.target
            UNIT
            mkdir -p /etc/containerd
            /usr/local/bin/containerd config default | sed 's/SystemdCgroup = false/SystemdCgroup = true/' > /etc/containerd/config.toml
            systemctl daemon-reload
            systemctl enable --now containerd
            fi

            # kubelet, kubeadm and kubectl of exactly this version from pkgs.k8s.io, held against updates.
            if command -v apt-get >/dev/null; then
              export DEBIAN_FRONTEND=noninteractive
              apt-get update -q
              apt-get install -y -q ca-certificates curl gnupg conntrack socat
              mkdir -p /etc/apt/keyrings
              curl -fsSL "\${PKGS}/deb/Release.key" | gpg --batch --yes --dearmor -o /etc/apt/keyrings/kubernetes.gpg
              echo "deb [signed-by=/etc/apt/keyrings/kubernetes.gpg] \${PKGS}/deb/ /" > /etc/apt/sources.list.d/kubernetes.list
              apt-get update -q
              # Read the whole list (no early exit): an early exit would break the pipe under pipefail.
              pkg=$(apt-cache madison kubeadm | awk -v v="\${K8S_VERSION}-" 'index($3, v) == 1 && !found { print $3; found = 1 }')
              [ -n "$pkg" ] || { echo "kubeadm \${K8S_VERSION} not found in \${PKGS}" >&2; exit 1; }
              # A Cluster API image holds its own version; the selected one replaces it.
              apt-get install -y -q --allow-change-held-packages "kubelet=\${pkg}" "kubeadm=\${pkg}" "kubectl=\${pkg}"
              apt-mark hold kubelet kubeadm kubectl
            elif command -v dnf >/dev/null; then
              setenforce 0 || true
              sed -i 's/^SELINUX=enforcing$/SELINUX=permissive/' /etc/selinux/config || true
              cat > /etc/yum.repos.d/kubernetes.repo <<REPO
            [kubernetes]
            name=Kubernetes
            baseurl=\${PKGS}/rpm/
            enabled=1
            gpgcheck=1
            gpgkey=\${PKGS}/rpm/repodata/repomd.xml.key
            exclude=kubelet kubeadm kubectl cri-tools kubernetes-cni
            REPO
              dnf install -y conntrack-tools socat
              dnf install -y --disableexcludes=kubernetes "kubelet-\${K8S_VERSION}" "kubeadm-\${K8S_VERSION}" "kubectl-\${K8S_VERSION}"
            else
              echo "Unsupported distribution: apt-get or dnf is required" >&2
              exit 1
            fi
            systemctl enable kubelet

            # kubeadm init or join runs only with kubeadm of exactly the selected version.
            if [ "$(kubeadm version -o short)" != "v\${K8S_VERSION}" ]; then
              echo "kubeadm $(kubeadm version -o short) is installed, v\${K8S_VERSION} expected" >&2
              exit 1
            fi
          permissions: "0755"
          owner: root:root
      preKubeadmCommands:
        - if command -v apt-get >/dev/null; then apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q qemu-guest-agent; elif command -v dnf >/dev/null; then dnf install -y qemu-guest-agent; fi; systemctl enable --now qemu-guest-agent || true
        - /usr/local/bin/capi-navigator-install-kubernetes.sh || exit 1
        - f=/etc/default/kubelet; [ -d /etc/sysconfig ] && f=/etc/sysconfig/kubelet; echo "KUBELET_EXTRA_ARGS=--node-ip=$(ip -4 -o route get 10.20.0.1 | sed -n 's/.* src \\([0-9.]*\\).*/\\1/p')" > "$f"
      joinConfiguration:
        nodeRegistration:
          name: "{{ v1.local_hostname }}"
          kubeletExtraArgs:
            - name: cloud-provider
              value: external
            - name: provider-id
              value: proxmox://{{ v1.instance_id }}
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: pve-default
  namespace: proxmox
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: pve
spec:
  clusterName: pve
  replicas: 2
  rollout:
    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 1
        maxUnavailable: 0
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: pve
      capi-navigator.io/pool: default
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: pve
        capi-navigator.io/pool: default
    spec:
      clusterName: pve
      version: v1.35.9
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: KubeadmConfigTemplate
          name: pve-default-bdbbaa35
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: ProxmoxMachineTemplate
        name: pve-default-4c1744b0
---
apiVersion: addons.cluster.x-k8s.io/v1beta2
kind: ClusterResourceSet
metadata:
  name: pve-proxmox-cloud-config
  namespace: proxmox
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: pve
spec:
  clusterSelector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: pve
  resources:
    - kind: Secret
      name: pve-proxmox-cloud-config
  strategy: Reconcile
"
`;

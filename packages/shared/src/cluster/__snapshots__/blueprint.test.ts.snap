"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: ordered
  namespace: osb
  labels:
    osb.example.com/instance-id: b5a3f0c2-1d7e-4c51-9a8e-2f6b3c4d5e6f
    capi-navigator.io/ccm: aws
    capi-navigator.io/csi: aws
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: ordered
  annotations:
    capi-navigator.io/blueprint: small
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"blueprint":"small","infrastructure":{"apiServerLoadBalancer":true,"credentialRef":"aws-dev","image":"ami-0e27250725fa51794","network":{"availabilityZoneCount":1,"vpcCidr":"10.0.0.0/16"},"provider":"aws","region":"eu-central-1"},"kubernetes":{"flavor":"k0s","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.9+k0s.0"},"labels":{"osb.example.com/instance-id":"b5a3f0c2-1d7e-4c51-9a8e-2f6b3c4d5e6f"},"name":"ordered","namespace":"osb","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"t3.large","replicas":1},"mode":"standard","workerPools":[{"machineSize":"t3.xlarge","name":"default","replicas":3}]}}'
spec:
  clusterNetwork:
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:
        - 10.43.0.0/16
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: K0sControlPlane
    name: ordered-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: AWSCluster
    name: ordered
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSCluster
metadata:
  name: ordered
  namespace: osb
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: ordered
spec:
  region: eu-central-1
  identityRef:
    kind: AWSClusterStaticIdentity
    name: aws-dev
  sshKeyName: ""
  network:
    vpc:
      cidrBlock: 10.0.0.0/16
      availabilityZoneUsageLimit: 1
    cni:
      cniIngressRules:
        - description: Calico VXLAN
          fromPort: 4789
          toPort: 4789
          protocol: udp
    additionalControlPlaneIngressRules:
      - description: k0s Konnectivity (load balancer and controllers)
        fromPort: 8132
        toPort: 8132
        protocol: tcp
        sourceSecurityGroupRoles:
          - apiserver-lb
          - controlplane
      - description: k0s controller join API (load balancer and controllers)
        fromPort: 9443
        toPort: 9443
        protocol: tcp
        sourceSecurityGroupRoles:
          - apiserver-lb
          - controlplane
      - description: Kubelet API
        fromPort: 10250
        toPort: 10250
        protocol: tcp
        sourceSecurityGroupRoles:
          - node
          - controlplane
  controlPlaneLoadBalancer:
    loadBalancerType: nlb
    ingressRules:
      - description: Kubernetes API
        fromPort: 6443
        toPort: 6443
        protocol: tcp
        cidrBlocks:
          - 0.0.0.0/0
      - description: k0s Konnectivity
        fromPort: 8132
        toPort: 8132
        protocol: tcp
        sourceSecurityGroupRoles:
          - node
          - controlplane
          - apiserver-lb
          - lb
      - description: k0s controller join API
        fromPort: 9443
        toPort: 9443
        protocol: tcp
        sourceSecurityGroupRoles:
          - node
          - controlplane
          - apiserver-lb
          - lb
      - description: k0s Konnectivity (NAT gateways)
        fromPort: 8132
        toPort: 8132
        protocol: tcp
        natGatewaysIPsSource: true
      - description: k0s controller join API (NAT gateways)
        fromPort: 9443
        toPort: 9443
        protocol: tcp
        natGatewaysIPsSource: true
    additionalListeners:
      - port: 8132
        protocol: TCP
      - port: 9443
        protocol: TCP
  bastion:
    enabled: false
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSMachineTemplate
metadata:
  name: ordered-cp-3ac94b45
  namespace: osb
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: ordered
spec:
  template:
    spec:
      ami:
        id: ami-0e27250725fa51794
      instanceType: t3.large
      iamInstanceProfile: control-plane.cluster-api-provider-aws.sigs.k8s.io
      sshKeyName: ""
      rootVolume:
        size: 50
        type: gp3
      cloudInit:
        insecureSkipSecretsManager: true
      uncompressedUserData: false
      instanceMetadataOptions:
        httpEndpoint: enabled
        httpTokens: required
        httpPutResponseHopLimit: 2
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: K0sControlPlane
metadata:
  name: ordered-control-plane
  namespace: osb
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: ordered
spec:
  version: v1.35.9+k0s.0
  replicas: 1
  updateStrategy: Recreate
  machineTemplate:
    infrastructureRef:
      apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
      kind: AWSMachineTemplate
      name: ordered-cp-3ac94b45
      namespace: osb
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: AWSMachineTemplate
        name: ordered-cp-3ac94b45
  k0sConfigSpec:
    k0s:
      apiVersion: k0s.k0sproject.io/v1beta1
      kind: ClusterConfig
      metadata:
        name: k0s
      spec:
        api:
          extraArgs:
            anonymous-auth: "true"
        network:
          provider: calico
          calico:
            mode: vxlan
          podCIDR: 10.42.0.0/16
          serviceCIDR: 10.43.0.0/16
        telemetry:
          enabled: false
    args:
      - --enable-worker
      - --labels=node.kubernetes.io/exclude-from-external-load-balancers=
      - --enable-cloud-provider
      - --kubelet-root-dir=/var/lib/kubelet
    useSystemHostname: true
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSMachineTemplate
metadata:
  name: ordered-default-3103eab4
  namespace: osb
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: ordered
spec:

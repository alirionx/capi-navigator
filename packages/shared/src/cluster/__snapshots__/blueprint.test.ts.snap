"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: ordered
  namespace: osb
  labels:
    osb.example.com/instance-id: b5a3f0c2-1d7e-4c51-9a8e-2f6b3c4d5e6f
    capi-navigator.io/ccm: gcp

    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: ordered
  annotations:
    capi-navigator.io/blueprint: small
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"blueprint":"small","infrastructure":{"apiServerLoadBalancer":true,"controlPlaneServiceAccount":"capi@demo-proj.iam.gserviceaccount.com","credentialRef":"gcp-dev","image":"projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261015","network":{"nodeCidr":"10.6.0.0/24"},"project":"demo-proj","provider":"gcp","region":"europe-west6"},"kubernetes":{"flavor":"kubeadm","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.9"},"labels":{"osb.example.com/instance-id":"b5a3f0c2-1d7e-4c51-9a8e-2f6b3c4d5e6f"},"name":"ordered","namespace":"osb","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"e2-standard-2","replicas":1},"mode":"standard","workerPools":[{"machineSize":"n2-standard-4","name":"default","replicas":3}]}}'
spec:
  clusterNetwork:
    apiServerPort: 6443
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:

exports[`hosted control planes (FP-24) > AWS, 1 replica(s): k0smotron control plane in the host, k0s workers (FP24-F-04, FP24-F-05) 1`] = `
"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: tenant
  namespace: team-a
  labels:
    capi-navigator.io/ccm: aws
    capi-navigator.io/csi: aws
    capi-navigator.io/hosted-on: host
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
  annotations:
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"infrastructure":{"apiServerLoadBalancer":true,"credentialRef":"aws","image":"ami-0e27250725fa51794","network":{"availabilityZoneCount":1,"vpcCidr":"10.0.0.0/16"},"provider":"aws","region":"eu-central-1"},"kubernetes":{"flavor":"k0s","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.9+k0s.0"},"name":"tenant","namespace":"team-a","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"unused","replicas":1},"hosted":{"etcdVolumeGiB":1,"host":"host"},"mode":"hosted","workerPools":[{"machineSize":"small","name":"default","replicas":2}]}}'
spec:
  clusterNetwork:
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:
        - 10.43.0.0/16
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: K0smotronControlPlane
    name: tenant-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: AWSCluster
    name: tenant
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSCluster
metadata:
  name: tenant
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  region: eu-central-1
  identityRef:
    kind: AWSClusterStaticIdentity
    name: aws
  sshKeyName: ""
  network:
    vpc:
      cidrBlock: 10.0.0.0/16
      availabilityZoneUsageLimit: 1
    cni:
      cniIngressRules:
        - description: Calico VXLAN
          fromPort: 4789
          toPort: 4789
          protocol: udp
    additionalControlPlaneIngressRules:
      - description: Kubelet API
        fromPort: 10250
        toPort: 10250
        protocol: tcp
        sourceSecurityGroupRoles:
          - node
          - controlplane
  controlPlaneLoadBalancer:
    loadBalancerType: disabled
  bastion:
    enabled: false
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: K0smotronControlPlane
metadata:
  name: tenant-control-plane
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  version: v1.35.9+k0s.0
  replicas: 1
  image: quay.io/k0sproject/k0s
  remoteHostCluster:
    kubeconfigRef:
      name: host-kubeconfig
      namespace: team-a
      key: value
  service:
    type: LoadBalancer
    apiPort: 6443
    konnectivityPort: 8132
  storage:
    type: etcd
    etcd:
      image: quay.io/k0sproject/etcd:v3.7.1
      autoDeletePVCs: true
      persistence:
        size: 1Gi
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
  controlPlaneFlags:
    - --enable-cloud-provider=true
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: DoNotSchedule
      nodeTaintsPolicy: Honor
      labelSelector:
        matchLabels:
          app: k0smotron
          cluster: tenant
          component: cluster
  patches:
    - target:
        kind: StatefulSet
        component: etcd
      patch:
        type: strategic
        content: '{"spec":{"template":{"spec":{"topologySpreadConstraints":[{"maxSkew":1,"topologyKey":"kubernetes.io/hostname","whenUnsatisfiable":"DoNotSchedule","nodeTaintsPolicy":"Honor","labelSelector":{"matchLabels":{"app":"k0smotron","cluster":"tenant","component":"etcd"}}}]}}}}'
  k0sConfig:
    apiVersion: k0s.k0sproject.io/v1beta1
    kind: ClusterConfig
    metadata:
      name: k0s
    spec:
      api:
        extraArgs:
          anonymous-auth: "true"
      network:
        provider: calico
        calico:
          mode: vxlan
        podCIDR: 10.42.0.0/16
        serviceCIDR: 10.43.0.0/16
      telemetry:
        enabled: false
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSMachineTemplate
metadata:
  name: tenant-default-5bb545f4
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  template:
    spec:
      ami:
        id: ami-0e27250725fa51794
      instanceType: small
      iamInstanceProfile: control-plane.cluster-api-provider-aws.sigs.k8s.io
      sshKeyName: ""
      rootVolume:
        size: 50
        type: gp3
      cloudInit:
        insecureSkipSecretsManager: true
      uncompressedUserData: false
      instanceMetadataOptions:
        httpEndpoint: enabled
        httpTokens: required
        httpPutResponseHopLimit: 2
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: K0sWorkerConfigTemplate
metadata:
  name: tenant-default-82d9f2d0
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  template:
    spec:
      version: v1.35.9+k0s.0
      args:
        - --enable-cloud-provider
        - --kubelet-root-dir=/var/lib/kubelet
      useSystemHostname: true
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: tenant-default
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  clusterName: tenant
  replicas: 2
  rollout:
    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 1
        maxUnavailable: 0
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: tenant
      capi-navigator.io/pool: default
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: tenant
        capi-navigator.io/pool: default
    spec:
      clusterName: tenant
      version: v1.35.9+k0s
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: K0sWorkerConfigTemplate
          name: tenant-default-82d9f2d0
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: AWSMachineTemplate
        name: tenant-default-5bb545f4
"
`;


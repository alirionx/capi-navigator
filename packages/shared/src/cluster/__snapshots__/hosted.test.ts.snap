    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  template:
    spec:
      sourceNode: homeserver
      templateID: 7211
      full: true
      storage: local-zfs
      numSockets: 1
      numCores: 2
      memoryMiB: 4096
      disks:
        bootVolume:
          disk: scsi0
          sizeGb: 40
      network:
        networkDevices:
          - name: net0
            bridge: vmbr0
            model: virtio
            defaultIPv4: true
      tags:
        - capi-navigator
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: K0sWorkerConfigTemplate
metadata:
  name: tenant-default-96e45858
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  template:
    spec:
      version: v1.35.9+k0s.0
      args:
        - --enable-cloud-provider
        - --kubelet-extra-args=--node-ip=$(ip -4 -o route get 192.168.10.1 | sed -n 's/.* src \\([0-9.]*\\).*/\\1/p')
        - --kubelet-root-dir=/var/lib/kubelet
      useSystemHostname: true
      preK0sCommands:
        - if command -v apt-get >/dev/null; then apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q qemu-guest-agent; elif command -v dnf >/dev/null; then dnf install -y qemu-guest-agent; fi; systemctl enable --now qemu-guest-agent || true
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: tenant-default
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  clusterName: tenant
  replicas: 2
  rollout:
    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 1
        maxUnavailable: 0
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: tenant
      capi-navigator.io/pool: default
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: tenant
        capi-navigator.io/pool: default
    spec:
      clusterName: tenant
      version: v1.35.9+k0s
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: K0sWorkerConfigTemplate
          name: tenant-default-96e45858
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: ProxmoxMachineTemplate
        name: tenant-default-b02f4e7a
---
apiVersion: addons.cluster.x-k8s.io/v1beta2
kind: ClusterResourceSet
metadata:
  name: tenant-proxmox-cloud-config
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: tenant
spec:
  clusterSelector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: tenant
  resources:
    - kind: Secret
      name: tenant-proxmox-cloud-config
  strategy: Reconcile
"
`;

exports[`bastion host (FP5-F-20) > AWS: CAPA bastion restricted to the allowed networks 1`] = `
"apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSCluster
metadata:
  name: demo-aws
  namespace: default
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws
spec:
  region: eu-central-1
  identityRef:
    kind: AWSClusterStaticIdentity
    name: aws-dev
  sshKeyName: ops
  network:
    vpc:
      cidrBlock: 10.0.0.0/16
      availabilityZoneUsageLimit: 1
    cni:
      cniIngressRules:
        - description: BGP
          fromPort: 179
          toPort: 179
          protocol: tcp
        - description: IP-in-IP
          fromPort: -1
          toPort: 65535
          protocol: "4"
        - description: Calico Typha
          fromPort: 5473
          toPort: 5473
          protocol: tcp
        - description: Calico Typha health check
          fromPort: 9098
          toPort: 9098
          protocol: tcp
        - description: Calico health check
          fromPort: 9099
          toPort: 9099
          protocol: tcp
    additionalControlPlaneIngressRules:
      - description: RKE2 supervisor
        fromPort: 9345
        toPort: 9345
        protocol: tcp
        sourceSecurityGroupRoles:
          - node
          - controlplane
          - apiserver-lb
          - lb
  controlPlaneLoadBalancer:
    loadBalancerType: nlb
    ingressRules:
      - description: Kubernetes API
        fromPort: 6443
        toPort: 6443
        protocol: tcp
        cidrBlocks:
          - 0.0.0.0/0
  bastion:
    enabled: true
    allowedCIDRBlocks:
      - 203.0.113.7/32
    instanceType: t3.micro
"
`;

exports[`bastion host (FP5-F-20) > OpenStack: CAPO bastion with flavor, cluster image and key pair; disabled keeps the spec 1`] = `
"apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackCluster
metadata:
  name: demo
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  identityRef:
    type: ClusterIdentity
    name: infomaniak
    cloudName: infomaniak
  externalNetwork:
    id: 0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d
  managedSubnets:
    - cidr: 10.6.0.0/24
      dnsNameservers:
        - 1.1.1.1
        - 8.8.8.8
  managedSecurityGroups:
    allowAllInClusterTraffic: true
  apiServer:
    managedLoadBalancer:
      enabled: true
  bastion:
    enabled: true
    spec:
      flavor:
        filter:
          name: a1-ram2-disk20-perf1
      image:
        id: 6f1b2a3c-0d4e-4f5a-8b6c-7d8e9fa0b1c2
      sshKeyName: my-keys
"
`;

exports[`k0s flavor (FP-9) > AWS standard 1`] = `
"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: demo-aws-k0s
  namespace: default
  labels:
    capi-navigator.io/ccm: aws
    capi-navigator.io/csi: aws
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws-k0s
  annotations:
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"infrastructure":{"apiServerLoadBalancer":true,"credentialRef":"aws-dev","image":"ami-0e27250725fa51794","network":{"availabilityZoneCount":1,"vpcCidr":"10.0.0.0/16"},"provider":"aws","region":"eu-central-1","sshKeyName":"ops"},"kubernetes":{"flavor":"k0s","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.8+k0s.1"},"name":"demo-aws-k0s","namespace":"default","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"t3.large","replicas":3},"mode":"standard","workerPools":[{"machineSize":"t3.large","name":"default","replicas":2}]}}'
spec:
  clusterNetwork:
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:
        - 10.43.0.0/16
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: K0sControlPlane
    name: demo-aws-k0s-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: AWSCluster
    name: demo-aws-k0s
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSCluster
metadata:
  name: demo-aws-k0s
  namespace: default
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws-k0s
spec:
  region: eu-central-1
  identityRef:
    kind: AWSClusterStaticIdentity
    name: aws-dev
  sshKeyName: ops
  network:
    vpc:
      cidrBlock: 10.0.0.0/16
      availabilityZoneUsageLimit: 1
    cni:
      cniIngressRules:
        - description: Calico VXLAN
          fromPort: 4789
          toPort: 4789
          protocol: udp
        - description: Kubelet API
          fromPort: 10250
          toPort: 10250
          protocol: tcp
  controlPlaneLoadBalancer:
    loadBalancerType: nlb
    ingressRules:
      - description: Kubernetes API
        fromPort: 6443
        toPort: 6443
        protocol: tcp
        cidrBlocks:
          - 0.0.0.0/0
      - description: k0s Konnectivity
        fromPort: 8132
        toPort: 8132
        protocol: tcp
        sourceSecurityGroupRoles:
          - node
          - controlplane
          - apiserver-lb
          - lb
      - description: k0s controller join API
        fromPort: 9443
        toPort: 9443
        protocol: tcp
        sourceSecurityGroupRoles:
          - node
          - controlplane
          - apiserver-lb
          - lb
    additionalListeners:
      - port: 8132
        protocol: TCP
      - port: 9443
        protocol: TCP
  bastion:
    enabled: false
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSMachineTemplate
metadata:
  name: demo-aws-k0s-cp-0574e5e7
  namespace: default
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws-k0s
spec:
  template:
    spec:
      ami:
        id: ami-0e27250725fa51794
      instanceType: t3.large
      iamInstanceProfile: control-plane.cluster-api-provider-aws.sigs.k8s.io
      sshKeyName: ops
      rootVolume:
        size: 50
        type: gp3
      cloudInit:
        insecureSkipSecretsManager: true
      instanceMetadataOptions:
        httpEndpoint: enabled
        httpTokens: required
        httpPutResponseHopLimit: 2
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: K0sControlPlane
metadata:
  name: demo-aws-k0s-control-plane
  namespace: default
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws-k0s
spec:
  version: v1.35.8+k0s.1
  replicas: 3
  updateStrategy: Recreate
  machineTemplate:
    infrastructureRef:
      apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
      kind: AWSMachineTemplate
      name: demo-aws-k0s-cp-0574e5e7
      namespace: default
  k0sConfigSpec:
    k0s:
      apiVersion: k0s.k0sproject.io/v1beta1
      kind: ClusterConfig
      metadata:
        name: k0s
      spec:
        api:
          extraArgs:
            anonymous-auth: "true"
        network:
          provider: calico
          calico:
            mode: vxlan
          podCIDR: 10.42.0.0/16
          serviceCIDR: 10.43.0.0/16
        telemetry:
          enabled: false
    args:
      - --enable-worker
      - --enable-cloud-provider
      - --kubelet-root-dir=/var/lib/kubelet
    useSystemHostname: true
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSMachineTemplate
metadata:
  name: demo-aws-k0s-default-c11924f6

exports[`transformation snapshots (FP5-F-01, NF-14) > AWS all-in-one 1`] = `
"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: demo-aws-aio
  namespace: default
  labels:
    capi-navigator.io/ccm: aws
    capi-navigator.io/csi: aws
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws-aio
  annotations:
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"infrastructure":{"apiServerLoadBalancer":true,"credentialRef":"aws-dev","image":"ami-0e27250725fa51794","network":{"availabilityZoneCount":1,"vpcCidr":"10.0.0.0/16"},"provider":"aws","region":"eu-central-1","sshKeyName":"ops"},"kubernetes":{"flavor":"rke2","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.9+rke2r1"},"name":"demo-aws-aio","namespace":"default","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"t3.large","replicas":1},"mode":"all-in-one","workerPools":[]}}'
spec:
  clusterNetwork:
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:
        - 10.43.0.0/16
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: RKE2ControlPlane
    name: demo-aws-aio-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: AWSCluster
    name: demo-aws-aio
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSCluster
metadata:
  name: demo-aws-aio
  namespace: default
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws-aio
spec:
  region: eu-central-1
  identityRef:
    kind: AWSClusterStaticIdentity
    name: aws-dev
  sshKeyName: ops
  network:
    vpc:
      cidrBlock: 10.0.0.0/16
      availabilityZoneUsageLimit: 1
    cni:
      cniIngressRules:
        - description: BGP
          fromPort: 179
          toPort: 179
          protocol: tcp
        - description: IP-in-IP
          fromPort: -1
          toPort: 65535
          protocol: "4"
        - description: Calico Typha
          fromPort: 5473
          toPort: 5473
          protocol: tcp
        - description: Calico Typha health check
          fromPort: 9098
          toPort: 9098
          protocol: tcp
        - description: Calico health check
          fromPort: 9099
          toPort: 9099
          protocol: tcp
    additionalControlPlaneIngressRules:
      - description: RKE2 supervisor
        fromPort: 9345
        toPort: 9345
        protocol: tcp
        sourceSecurityGroupRoles:
          - node
          - controlplane
          - apiserver-lb
          - lb
  controlPlaneLoadBalancer:
    loadBalancerType: nlb
    ingressRules:
      - description: Kubernetes API
        fromPort: 6443
        toPort: 6443
        protocol: tcp
        cidrBlocks:
          - 0.0.0.0/0
  bastion:
    enabled: false
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: AWSMachineTemplate
metadata:
  name: demo-aws-aio-cp-0574e5e7
  namespace: default
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws-aio
spec:
  template:
    spec:
      ami:
        id: ami-0e27250725fa51794
      instanceType: t3.large
      iamInstanceProfile: control-plane.cluster-api-provider-aws.sigs.k8s.io
      sshKeyName: ops
      rootVolume:
        size: 50
        type: gp3
      cloudInit:
        insecureSkipSecretsManager: true
      instanceMetadataOptions:
        httpEndpoint: enabled
        httpTokens: required
        httpPutResponseHopLimit: 2
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: RKE2ControlPlane
metadata:
  name: demo-aws-aio-control-plane
  namespace: default
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aws-aio
spec:
  version: v1.35.9+rke2r1
  replicas: 1
  registrationMethod: internal-first
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: AWSMachineTemplate
        name: demo-aws-aio-cp-0574e5e7
  rolloutStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
  serverConfig:
    cni: calico
    cloudProviderName: external
    disableComponents:
      kubernetesComponents:
        - cloudController
  agentConfig:
    nodeName: "{{ v1.local_hostname }}"
    kubelet:
      extraArgs:
        - provider-id=aws:///{{ v1.availability_zone }}/{{ v1.instance_id }}
  preRKE2Commands:
    - if grep -qE '^ID_LIKE=.*(rhel|fedora)' /etc/os-release && grep -qE '^VERSION_ID="?10' /etc/os-release; then dnf install -y kernel-modules-extra; fi
  gzipUserData: false
"
`;


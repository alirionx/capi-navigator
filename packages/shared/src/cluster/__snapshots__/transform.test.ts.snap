    spec:
      flavor:
        filter:
          name: a2-ram4-disk0
      image:
        id: 6f1b2a3c-0d4e-4f5a-8b6c-7d8e9fa0b1c2
      sshKeyName: my-keys
      rootVolume:
        sizeGiB: 50
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: K0sControlPlane
metadata:
  name: demo-k0s-aio-control-plane
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-k0s-aio
spec:
  version: v1.35.8+k0s.1
  replicas: 1
  updateStrategy: Recreate
  machineTemplate:
    infrastructureRef:
      apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
      kind: OpenStackMachineTemplate
      name: demo-k0s-aio-cp-a6815c13
      namespace: team-a
  k0sConfigSpec:
    k0s:
      apiVersion: k0s.k0sproject.io/v1beta1
      kind: ClusterConfig
      metadata:
        name: k0s
      spec:
        api:
          extraArgs:
            anonymous-auth: "true"
        network:
          provider: calico
          calico:
            mode: vxlan
          podCIDR: 10.42.0.0/16
          serviceCIDR: 10.43.0.0/16
        telemetry:
          enabled: false
    args:
      - --enable-worker
      - --no-taints
      - --enable-cloud-provider
      - --kubelet-root-dir=/var/lib/kubelet
    useSystemHostname: true
---
apiVersion: addons.cluster.x-k8s.io/v1beta2
kind: ClusterResourceSet
metadata:
  name: demo-k0s-aio-cloud-config
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-k0s-aio
spec:
  clusterSelector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: demo-k0s-aio
  resources:
    - kind: Secret
      name: demo-k0s-aio-cloud-config
  strategy: Reconcile
"
`;


spec:
  clusterNetwork:
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:
        - 10.43.0.0/16
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: RKE2ControlPlane
    name: demo-aio-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: OpenStackCluster
    name: demo-aio
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackCluster
metadata:
  name: demo-aio
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-aio
spec:
  identityRef:
    type: ClusterIdentity
    name: infomaniak
    cloudName: infomaniak
  externalNetwork:
    id: 0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d
  managedSubnets:
    - cidr: 10.6.0.0/24
      dnsNameservers:
        - 1.1.1.1
        - 8.8.8.8
  managedSecurityGroups:
    allowAllInClusterTraffic: true
    controlPlaneNodesSecurityGroupRules:
      - name: nodeport-tcp
        description: Kubernetes NodePort services (TCP)
        direction: ingress
        etherType: IPv4
        protocol: tcp
        portRangeMin: 30000
        portRangeMax: 32767
        remoteIPPrefix: 0.0.0.0/0
      - name: nodeport-udp
        description: Kubernetes NodePort services (UDP)
        direction: ingress
        etherType: IPv4
        protocol: udp
        portRangeMin: 30000
        portRangeMax: 32767
        remoteIPPrefix: 0.0.0.0/0
  apiServer:
    managedLoadBalancer:
      enabled: true
---

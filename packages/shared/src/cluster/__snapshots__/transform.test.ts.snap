    name: demo-k0s-aio
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackCluster
metadata:
  name: demo-k0s-aio
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-k0s-aio
spec:
  identityRef:
    type: ClusterIdentity
    name: infomaniak
    cloudName: infomaniak
  externalNetwork:
    id: 0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d
  managedSubnets:
    - cidr: 10.6.0.0/24
      dnsNameservers:
        - 1.1.1.1
        - 8.8.8.8
  managedSecurityGroups:
    allowAllInClusterTraffic: true
    controlPlaneNodesSecurityGroupRules:
      - name: nodeport-tcp
        description: Kubernetes NodePort services (TCP)
        direction: ingress
        etherType: IPv4
        protocol: tcp
        portRangeMin: 30000
        portRangeMax: 32767
        remoteIPPrefix: 0.0.0.0/0
      - name: nodeport-udp
        description: Kubernetes NodePort services (UDP)
        direction: ingress
        etherType: IPv4
        protocol: udp
        portRangeMin: 30000
        portRangeMax: 32767
        remoteIPPrefix: 0.0.0.0/0
  apiServer:
    managedLoadBalancer:
      enabled: true
      additionalPorts:
        - 8132
        - 9443
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackMachineTemplate
metadata:
  name: demo-k0s-aio-cp-a6815c13
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-k0s-aio

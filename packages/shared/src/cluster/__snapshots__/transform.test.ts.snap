exports[`k0s flavor (FP-9) > node customization and SSH keys (FP9-F-03) 1`] = `
"apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: K0sWorkerConfigTemplate
metadata:
  name: demo-k0s-default-38f9be42
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-k0s
spec:
  template:
    spec:
      version: v1.35.8+k0s.1
      args:
        - --enable-cloud-provider
        - --kubelet-root-dir=/var/lib/kubelet
      useSystemHostname: true
      files:
        - path: /etc/motd
          content: |
            managed by CAPI Navigator
          permissions: "0644"
        - path: /etc/capi-navigator/ssh_authorized_keys
          content: |
            ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample admin@example
          permissions: "0600"
      preK0sCommands:
        - 'u=$(getent passwd 1000 | cut -d: -f1); if [ -n "$u" ]; then h=$(getent passwd "$u" | cut -d: -f6); install -d -m 0700 -o "$u" -g "$u" "$h/.ssh"; cat /etc/capi-navigator/ssh_authorized_keys >> "$h/.ssh/authorized_keys"; chown "$u:$u" "$h/.ssh/authorized_keys"; chmod 0600 "$h/.ssh/authorized_keys"; fi'
        - echo before
      postK0sCommands:
        - echo after
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: K0sWorkerConfigTemplate
metadata:
  name: demo-k0s-gpu-d4ff33b0
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-k0s
spec:
  template:
    spec:
      version: v1.35.8+k0s.1
      args:
        - --enable-cloud-provider
        - --kubelet-root-dir=/var/lib/kubelet
        - --labels=example.com/gpu=true
      useSystemHostname: true
      files:
        - path: /etc/capi-navigator/ssh_authorized_keys
          content: |
            ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample admin@example
          permissions: "0600"
      preK0sCommands:
        - 'u=$(getent passwd 1000 | cut -d: -f1); if [ -n "$u" ]; then h=$(getent passwd "$u" | cut -d: -f6); install -d -m 0700 -o "$u" -g "$u" "$h/.ssh"; cat /etc/capi-navigator/ssh_authorized_keys >> "$h/.ssh/authorized_keys"; chown "$u:$u" "$h/.ssh/authorized_keys"; chmod 0600 "$h/.ssh/authorized_keys"; fi'
"
`;


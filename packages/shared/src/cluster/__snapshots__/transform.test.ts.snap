apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackCluster
metadata:
  name: demo
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  identityRef:
    type: ClusterIdentity
    name: infomaniak
    cloudName: infomaniak
  externalNetwork:
    id: 0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d
  managedSubnets:
    - cidr: 10.6.0.0/24
      dnsNameservers:
        - 1.1.1.1
        - 8.8.8.8
  managedSecurityGroups:
    allowAllInClusterTraffic: true
  apiServer:
    managedLoadBalancer:
      enabled: true
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackMachineTemplate
metadata:
  name: demo-cp-a6815c13
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  template:
    spec:
      flavor:
        filter:
          name: a2-ram4-disk0
      image:
        id: 6f1b2a3c-0d4e-4f5a-8b6c-7d8e9fa0b1c2
      sshKeyName: my-keys
      rootVolume:
        sizeGiB: 50
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: RKE2ControlPlane
metadata:
  name: demo-control-plane
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  version: v1.35.9+rke2r1
  replicas: 3
  registrationMethod: internal-first
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: OpenStackMachineTemplate
        name: demo-cp-a6815c13
  rolloutStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
  serverConfig:
    cni: calico
    cloudProviderName: external
    disableComponents:
      kubernetesComponents:
        - cloudController
  agentConfig:
    nodeName: "{{ v1.local_hostname }}"
    nodeTaints:
      - node-role.kubernetes.io/control-plane:NoSchedule
    kubelet:
      extraArgs:
        - provider-id=openstack:///{{ v1.instance_id }}
    additionalUserData:
      config: |
        ssh_authorized_keys:
          - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample admin@example"
  preRKE2Commands:
    - if grep -qE '^ID_LIKE=.*(rhel|fedora)' /etc/os-release && grep -qE '^VERSION_ID="?10' /etc/os-release; then dnf install -y kernel-modules-extra; fi
  gzipUserData: false
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackMachineTemplate
metadata:
  name: demo-default-c264cd9f
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  template:
    spec:
      flavor:
        filter:
          name: a4-ram8-disk50-perf1
      image:
        id: 6f1b2a3c-0d4e-4f5a-8b6c-7d8e9fa0b1c2
      sshKeyName: my-keys
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: RKE2ConfigTemplate
metadata:
  name: demo-default-20df1989
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  template:
    spec:
      agentConfig:
        nodeName: "{{ v1.local_hostname }}"
        kubelet:
          extraArgs:
            - provider-id=openstack:///{{ v1.instance_id }}
            - cloud-provider=external
        additionalUserData:
          config: |
            ssh_authorized_keys:
              - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample admin@example"
      files:
        - path: /etc/motd
          content: |
            managed by CAPI Navigator
          permissions: "0644"
        - path: /etc/app/token
          contentFrom:
            secret:
              name: app-token
              key: token
          permissions: "0600"
      preRKE2Commands:
        - if grep -qE '^ID_LIKE=.*(rhel|fedora)' /etc/os-release && grep -qE '^VERSION_ID="?10' /etc/os-release; then dnf install -y kernel-modules-extra; fi
        - echo before
      postRKE2Commands:
        - echo after
      gzipUserData: false
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: demo-default
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  clusterName: demo
  replicas: 2
  rollout:
    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 1
        maxUnavailable: 0
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: demo
      capi-navigator.io/pool: default
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: demo
        capi-navigator.io/pool: default
    spec:
      clusterName: demo
      version: v1.35.9+rke2r1
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: RKE2ConfigTemplate
          name: demo-default-20df1989
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: OpenStackMachineTemplate
        name: demo-default-c264cd9f
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta2
kind: OpenStackMachineTemplate
metadata:
  name: demo-gpu-dc53c27b
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  template:
    spec:
      flavor:
        filter:
          name: a8-ram32-disk80-perf1
      image:
        id: 6f1b2a3c-0d4e-4f5a-8b6c-7d8e9fa0b1c2
      sshKeyName: my-keys
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: RKE2ConfigTemplate
metadata:
  name: demo-gpu-c643f674
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  template:
    spec:
      agentConfig:
        nodeName: "{{ v1.local_hostname }}"
        nodeLabels:
          - example.com/gpu=true
        kubelet:
          extraArgs:
            - provider-id=openstack:///{{ v1.instance_id }}
            - cloud-provider=external
        additionalUserData:
          config: |
            ssh_authorized_keys:
              - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExample admin@example"
      preRKE2Commands:
        - if grep -qE '^ID_LIKE=.*(rhel|fedora)' /etc/os-release && grep -qE '^VERSION_ID="?10' /etc/os-release; then dnf install -y kernel-modules-extra; fi
      gzipUserData: false
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: demo-gpu
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  clusterName: demo
  replicas: 1
  rollout:
    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 1
        maxUnavailable: 0
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: demo
      capi-navigator.io/pool: gpu
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: demo
        capi-navigator.io/pool: gpu
    spec:
      clusterName: demo
      version: v1.35.9+rke2r1
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: RKE2ConfigTemplate
          name: demo-gpu-c643f674
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: OpenStackMachineTemplate
        name: demo-gpu-dc53c27b
---
apiVersion: addons.cluster.x-k8s.io/v1beta2
kind: ClusterResourceSet
metadata:
  name: demo-cloud-config
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo
spec:
  clusterSelector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: demo
  resources:
    - kind: Secret
      name: demo-cloud-config
  strategy: Reconcile
"
`;

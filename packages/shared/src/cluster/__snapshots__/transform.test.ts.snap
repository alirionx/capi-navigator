    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: OpenStackMachineTemplate
        name: demo-aio-cp-a6815c13
  rolloutStrategy:
    type: RollingUpdate
    rollingUpdate:

  gzipUserData: false
  privateRegistriesConfig:
    mirrors:
      docker.io:
        endpoint:
          - https://registry.example.internal
        rewrite:
          ^(.*)$: proxy-docker-io/$1
      registry.k8s.io:
        endpoint:
          - https://registry.example.internal

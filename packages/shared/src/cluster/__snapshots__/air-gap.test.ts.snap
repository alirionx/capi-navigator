apiVersion: infrastructure.cluster.x-k8s.io/v1alpha2
kind: ProxmoxMachineTemplate
metadata:
  name: offline-default-2b080706
  namespace: airgap
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: offline
spec:
  template:
    spec:
      sourceNode: pve1
      templateID: 7114
      full: true
      storage: local-zfs
      numSockets: 1
      numCores: 8
      memoryMiB: 16384
      disks:
        bootVolume:
          disk: virtio0
          sizeGb: 40
      network:
        networkDevices:
          - name: net0
            bridge: vmbr0
            model: virtio
            defaultIPv4: true
      tags:
        - capi-navigator
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: K0sWorkerConfigTemplate
metadata:
  name: offline-default-b7debfc3
  namespace: airgap
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: offline
spec:
  template:
    spec:
      version: v1.35.8+k0s.1
      args:
        - --enable-cloud-provider
        - --kubelet-extra-args=--node-ip=$(ip -4 -o route get 10.20.0.1 | sed -n 's/.* src \\([0-9.]*\\).*/\\1/p')
        - --kubelet-root-dir=/var/lib/kubelet
      useSystemHostname: true
      files:
        - path: /etc/capi-navigator/registry-ca.crt
          content: |
            -----BEGIN CERTIFICATE-----
            MIIBexample
            -----END CERTIFICATE-----
          permissions: "0644"
        - path: /usr/local/bin/capi-navigator-fetch-artifact
          content: |
            #!/usr/bin/env python3
            # Generated by CAPI Navigator (FP29-F-13): downloads files of an OCI artifact from the internal
            # registry by their layer digest and checks their sha256. Python 3 comes with cloud-init.
            # Usage: capi-navigator-fetch-artifact <registry URL> <repository> (<digest> <target> <mode>)...
            # A missing artifact, a registry that stays unreachable or a changed file end it with exit code 1.
            import hashlib
            import json
            import os
            import re
            import sys
            import time
            import urllib.error
            import urllib.parse
            import urllib.request

            ATTEMPTS = 10


            class DropTokenOffRegistry(urllib.request.HTTPRedirectHandler):
                """Registries may redirect blobs to object storage, which must not get the registry token."""

                def redirect_request(self, req, fp, code, msg, headers, newurl):
                    new = super().redirect_request(req, fp, code, msg, headers, newurl)
                    if new is not None and urllib.parse.urlsplit(newurl).netloc != urllib.parse.urlsplit(req.full_url).netloc:
                        new.remove_header("Authorization")
                    return new


            opener = urllib.request.build_opener(DropTokenOffRegistry)


            def fail(message):
                print("capi-navigator-fetch-artifact: " + message, file=sys.stderr)
                sys.exit(1)


            def bearer_token(challenge, repository):
                """Anonymous token as the registry asks for it (WWW-Authenticate: Bearer realm=...)."""
                if not challenge.lower().startswith("bearer "):
                    fail("the registry asks for credentials, anonymous pulls must be allowed: " + challenge)
                params = dict(re.findall(r'(\\w+)="([^"]*)"', challenge))
                realm = params.pop("realm", None)
                if not realm:
                    fail("no token realm in the registry's challenge: " + challenge)
                params.setdefault("scope", "repository:" + repository + ":pull")
                separator = "&" if "?" in realm else "?"
                with opener.open(realm + separator + urllib.parse.urlencode(params), timeout=30) as response:
                    body = json.load(response)
                token = body.get("token") or body.get("access_token")
                if not token:
                    fail("the registry returned no token")
                return token


            def fetch(base, repository, digest, target, mode):
                expected = digest.split(":", 1)[1]
                url = base.rstrip("/") + "/v2/" + repository + "/blobs/" + digest
                headers = {}
                os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
                partial = target + ".part"
                for attempt in range(1, ATTEMPTS + 1):
                    try:
                        sha = hashlib.sha256()
                        with opener.open(urllib.request.Request(url, headers=headers), timeout=60) as response:
                            with open(partial, "wb") as out:
                                for chunk in iter(lambda: response.read(1024 * 1024), b""):
                                    sha.update(chunk)
                                    out.write(chunk)
                        if sha.hexdigest() != expected:
                            os.remove(partial)
                            fail(target + ": sha256 " + sha.hexdigest() + " does not match the pinned " + digest)
                        os.chmod(partial, int(mode, 8))
                        os.replace(partial, target)
                        print("capi-navigator-fetch-artifact: " + target + " " + digest)
                        return
                    except urllib.error.HTTPError as err:
                        if err.code == 401:
                            headers = {"Authorization": "Bearer " + bearer_token(err.headers.get("WWW-Authenticate", ""), repository)}
                            continue
                        if err.code == 404:
                            fail(url + " not found: push the artifact to the internal registry")
                        error = "HTTP " + str(err.code)
                    except (urllib.error.URLError, OSError) as err:
                        error = str(err)
                    print("capi-navigator-fetch-artifact: attempt " + str(attempt) + " for " + url + ": " + error, file=sys.stderr)
                    time.sleep(min(2 ** attempt, 30))
                fail("giving up on " + url)


            def main(args):
                if len(args) < 5 or (len(args) - 2) % 3 != 0:
                    fail("usage: <registry URL> <repository> (<digest> <target> <mode>)...")
                base, repository, rest = args[0], args[1], args[2:]
                for i in range(0, len(rest), 3):
                    fetch(base, repository, rest[i], rest[i + 1], rest[i + 2])


            if __name__ == "__main__":
                main(sys.argv[1:])
          permissions: "0755"
        - path: /etc/k0s/containerd.d/cri-registry.toml
          content: |
            version = 2

            [plugins."io.containerd.grpc.v1.cri".registry]
            config_path = "/etc/k0s/containerd.d/certs.d"
          permissions: "0644"
        - path: /etc/k0s/containerd.d/certs.d/docker.io/hosts.toml
          content: |
            server = "https://registry-1.docker.io"

            [host."https://registry.example.internal/v2/proxy-docker-io"]
              capabilities = ["pull", "resolve"]
              override_path = true
          permissions: "0644"
        - path: /etc/k0s/containerd.d/certs.d/registry.k8s.io/hosts.toml
          content: |
            server = "https://registry.k8s.io"

            [host."https://registry.example.internal/v2/proxy-k8s-io"]
              capabilities = ["pull", "resolve"]
              override_path = true
          permissions: "0644"
        - path: /etc/k0s/containerd.d/certs.d/ghcr.io/hosts.toml
          content: |
            server = "https://ghcr.io"

            [host."https://registry.example.internal/v2/proxy-ghcr-io"]
              capabilities = ["pull", "resolve"]
              override_path = true
          permissions: "0644"
        - path: /etc/k0s/containerd.d/certs.d/quay.io/hosts.toml
          content: |
            server = "https://quay.io"

            [host."https://registry.example.internal/v2"]
              capabilities = ["pull", "resolve"]
              override_path = true
          permissions: "0644"
      preK0sCommands:
        - if command -v update-ca-certificates >/dev/null; then install -m 0644 /etc/capi-navigator/registry-ca.crt /usr/local/share/ca-certificates/capi-navigator-registry.crt && update-ca-certificates; else install -m 0644 /etc/capi-navigator/registry-ca.crt /etc/pki/ca-trust/source/anchors/capi-navigator-registry.crt && update-ca-trust extract; fi
        - python3 /usr/local/bin/capi-navigator-fetch-artifact https://registry.example.internal library/k0s-amd64 sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd /usr/local/bin/k0s 0755 || exit 1
      preInstalledK0s: true
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: offline-default
  namespace: airgap
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: offline
spec:
  clusterName: offline
  replicas: 1
  rollout:
    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 1
        maxUnavailable: 0
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: offline
      capi-navigator.io/pool: default
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: offline
        capi-navigator.io/pool: default
    spec:
      clusterName: offline
      version: v1.35.8+k0s
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: K0sWorkerConfigTemplate
          name: offline-default-b7debfc3
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: ProxmoxMachineTemplate
        name: offline-default-2b080706
---
apiVersion: addons.cluster.x-k8s.io/v1beta2
kind: ClusterResourceSet
metadata:
  name: offline-proxmox-cloud-config
  namespace: airgap
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: offline
spec:
  clusterSelector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: offline
  resources:
    - kind: Secret
      name: offline-proxmox-cloud-config
  strategy: Reconcile
"
`;

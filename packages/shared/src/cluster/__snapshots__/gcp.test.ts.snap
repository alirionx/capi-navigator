exports[`Google Cloud snapshots (FP25-F-06) > kubeadm all-in-one in one zone 1`] = `
"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: demo-gcp-kubeadm-aio
  namespace: team-a
  labels:
    capi-navigator.io/ccm: gcp
    capi-navigator.io/csi: gcp
    capi-navigator.io/cni: calico
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-kubeadm-aio
  annotations:
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"infrastructure":{"apiServerLoadBalancer":true,"controlPlaneServiceAccount":"capi@demo-proj.iam.gserviceaccount.com","credentialRef":"gcp-dev","image":"projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261015","network":{"nodeCidr":"10.6.0.0/24"},"project":"demo-proj","provider":"gcp","region":"europe-west6","zone":"europe-west6-b"},"kubernetes":{"flavor":"kubeadm","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.9"},"name":"demo-gcp-kubeadm-aio","namespace":"team-a","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"e2-standard-2","replicas":1},"mode":"all-in-one","workerPools":[]}}'
spec:
  clusterNetwork:
    apiServerPort: 6443
    pods:
      cidrBlocks:

  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: KubeadmControlPlane
    name: demo-gcp-kubeadm-aio-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: GCPCluster
    name: demo-gcp-kubeadm-aio
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: GCPCluster
metadata:
  name: demo-gcp-kubeadm-aio
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-kubeadm-aio
spec:
  project: demo-proj
  region: europe-west6
  credentialsRef:
    name: capi-navigator-credential-gcp-dev
    namespace: capg-system
  network:
    name: demo-gcp-kubeadm-aio
    autoCreateSubnetworks: false
    subnets:
      - name: demo-gcp-kubeadm-aio-nodes
        cidrBlock: 10.6.0.0/24
        region: europe-west6

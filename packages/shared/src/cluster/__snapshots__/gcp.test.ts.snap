exports[`Google Cloud snapshots (FP25-F-06) > k0s all-in-one in one zone 1`] = `
"apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: demo-gcp-k0s-aio
  namespace: team-a
  labels:
    capi-navigator.io/ccm: gcp

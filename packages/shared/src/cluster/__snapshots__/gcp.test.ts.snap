    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-k0s-aio
  annotations:
    capi-navigator.io/cluster-spec: '{"addons":{"cloudControllerManager":true,"csiDriver":true},"infrastructure":{"apiServerLoadBalancer":true,"controlPlaneServiceAccount":"capi@demo-proj.iam.gserviceaccount.com","credentialRef":"gcp-dev","image":"projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261015","network":{"nodeCidr":"10.6.0.0/24"},"project":"demo-proj","provider":"gcp","region":"europe-west6","zone":"europe-west6-b"},"kubernetes":{"flavor":"k0s","podCidr":"10.42.0.0/16","serviceCidr":"10.43.0.0/16","version":"v1.35.8+k0s.1"},"name":"demo-gcp-k0s-aio","namespace":"team-a","rollout":{"maxSurge":1,"maxUnavailable":0},"sshPublicKeys":[],"topology":{"controlPlane":{"machineSize":"e2-standard-2","replicas":1},"mode":"all-in-one","workerPools":[]}}'
spec:
  clusterNetwork:
    apiServerPort: 6443
    pods:
      cidrBlocks:
        - 10.42.0.0/16
    services:
      cidrBlocks:
        - 10.43.0.0/16
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: K0sControlPlane
    name: demo-gcp-k0s-aio-control-plane
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: GCPCluster
    name: demo-gcp-k0s-aio
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: GCPCluster
metadata:
  name: demo-gcp-k0s-aio
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-k0s-aio
spec:
  project: demo-proj
  region: europe-west6
  credentialsRef:
    name: capi-navigator-credential-gcp-dev
    namespace: capg-system
  network:
    name: demo-gcp-k0s-aio
    autoCreateSubnetworks: false
    subnets:
      - name: demo-gcp-k0s-aio-nodes
        cidrBlock: 10.6.0.0/24
        region: europe-west6
  failureDomains:
    - europe-west6-b
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: GCPMachineTemplate
metadata:
  name: demo-gcp-k0s-aio-cp-2a163f11
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-k0s-aio
spec:
  template:
    spec:
      instanceType: e2-standard-2
      subnet: demo-gcp-k0s-aio-nodes
      image: projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261015
      serviceAccounts:
        email: capi@demo-proj.iam.gserviceaccount.com
        scopes:
          - https://www.googleapis.com/auth/cloud-platform
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: K0sControlPlane
metadata:
  name: demo-gcp-k0s-aio-control-plane
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-k0s-aio
spec:
  version: v1.35.8+k0s.1
  replicas: 1
  updateStrategy: Recreate
  machineTemplate:
    infrastructureRef:
      apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
      kind: GCPMachineTemplate
      name: demo-gcp-k0s-aio-cp-2a163f11
      namespace: team-a
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: GCPMachineTemplate
        name: demo-gcp-k0s-aio-cp-2a163f11
  k0sConfigSpec:
    k0s:
      apiVersion: k0s.k0sproject.io/v1beta1
      kind: ClusterConfig
      metadata:
        name: k0s
      spec:
        api:
          extraArgs:
            anonymous-auth: "true"
        network:
          provider: calico
          calico:
            mode: vxlan
          podCIDR: 10.42.0.0/16
          serviceCIDR: 10.43.0.0/16
        telemetry:
          enabled: false
    args:
      - --enable-worker
      - --no-taints
      - --disable-components=konnectivity-server
      - --enable-cloud-provider
      - --kubelet-root-dir=/var/lib/kubelet
    useSystemHostname: true
    preK0sCommands:
      - hostnamectl set-hostname "$(hostname -s)"
"
`;


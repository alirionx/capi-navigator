    spec:
      instanceType: n2-standard-4
      subnet: demo-gcp-rke2-nodes
      image: projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261015
      rootDeviceSize: 80
      rootDeviceType: pd-balanced
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: RKE2ConfigTemplate
metadata:
  name: demo-gcp-rke2-default-473dbb89
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-rke2
spec:
  template:
    spec:
      agentConfig:
        nodeName: "{{ v1.local_hostname }}"
        kubelet:
          extraArgs:
            - provider-id=gce://demo-proj/{{ v1.availability_zone }}/{{ v1.local_hostname }}
            - cloud-provider=external
      preRKE2Commands:
        - hostnamectl set-hostname "$(hostname -s)"
        - if grep -qE '^ID_LIKE=.*(rhel|fedora)' /etc/os-release && grep -qE '^VERSION_ID="?10' /etc/os-release; then dnf install -y kernel-modules-extra; fi
      gzipUserData: false
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: demo-gcp-rke2-default
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-rke2
spec:
  clusterName: demo-gcp-rke2
  replicas: 2
  rollout:
    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 1
        maxUnavailable: 0
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: demo-gcp-rke2
      capi-navigator.io/pool: default
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: demo-gcp-rke2
        capi-navigator.io/pool: default
    spec:
      clusterName: demo-gcp-rke2
      version: v1.35.9+rke2r1
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: RKE2ConfigTemplate
          name: demo-gcp-rke2-default-473dbb89
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: GCPMachineTemplate
        name: demo-gcp-rke2-default-06abc031
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDrainRule
metadata:
  name: demo-gcp-rke2-skip-tigera-operator
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-rke2
spec:
  drain:
    behavior: Skip
  machines:
    - clusterSelector:
        matchLabels:
          cluster.x-k8s.io/cluster-name: demo-gcp-rke2
  pods:
    - selector:
        matchLabels:
          k8s-app: tigera-operator
      namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: tigera-operator
"
`;

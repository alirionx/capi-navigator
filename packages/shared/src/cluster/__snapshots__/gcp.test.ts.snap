  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: GCPCluster
    name: demo-gcp-rke2
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: GCPCluster
metadata:
  name: demo-gcp-rke2
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-rke2
spec:
  project: demo-proj
  region: europe-west6
  credentialsRef:
    name: capi-navigator-credential-gcp-dev
    namespace: capg-system
  network:
    name: demo-gcp-rke2
    autoCreateSubnetworks: false
    subnets:
      - name: demo-gcp-rke2-nodes
        cidrBlock: 10.6.0.0/24
        region: europe-west6
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: GCPMachineTemplate
metadata:
  name: demo-gcp-rke2-cp-28667f9f
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-rke2
spec:
  template:
    spec:
      instanceType: e2-standard-2
      subnet: demo-gcp-rke2-nodes
      image: projects/ubuntu-os-cloud/global/images/ubuntu-2404-noble-amd64-v20261015
      serviceAccounts:
        email: capi@demo-proj.iam.gserviceaccount.com
        scopes:
          - https://www.googleapis.com/auth/cloud-platform
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: RKE2ControlPlane
metadata:
  name: demo-gcp-rke2-control-plane
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-rke2
spec:
  version: v1.35.9+rke2r1
  replicas: 3
  registrationMethod: internal-first
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: GCPMachineTemplate
        name: demo-gcp-rke2-cp-28667f9f
  rolloutStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
  serverConfig:
    cni: calico
    cloudProviderName: external
    disableComponents:
      kubernetesComponents:
        - cloudController
    kubeAPIServer:
      extraArgs:
        - anonymous-auth=true
  agentConfig:
    nodeName: "{{ v1.local_hostname }}"
    nodeTaints:
      - node-role.kubernetes.io/control-plane:NoSchedule
    kubelet:
      extraArgs:
        - provider-id=gce://demo-proj/{{ v1.availability_zone }}/{{ v1.local_hostname }}
  preRKE2Commands:
    - hostnamectl set-hostname "$(hostname -s)"
    - if grep -qE '^ID_LIKE=.*(rhel|fedora)' /etc/os-release && grep -qE '^VERSION_ID="?10' /etc/os-release; then dnf install -y kernel-modules-extra; fi
  gzipUserData: false
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: GCPMachineTemplate
metadata:
  name: demo-gcp-rke2-default-06abc031
  namespace: team-a
  labels:
    capi-navigator.io/managed-by: capi-navigator
    cluster.x-k8s.io/cluster-name: demo-gcp-rke2
spec:

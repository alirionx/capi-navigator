# Copy to .env.local for `pnpm dev` (never commit .env.local).

# FP1-F-02: password of the initial admin on first start (at least 12 characters).
# Without it, a random password is generated into the Secret capi-navigator-initial-admin:
#   kubectl -n capi-navigator-system get secret capi-navigator-initial-admin \
#     -o jsonpath='{.data.password}' | base64 -d
# INITIAL_ADMIN_PASSWORD=change-me-please

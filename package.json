{
  "name": "capi-navigator",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "notices:generate": "node scripts/third-party-notices.mjs",
    "secrets:scan": "bash scripts/secret-scan.sh",
    "typecheck": "pnpm -r typecheck",
    "test:coverage": "pnpm --filter @capi-navigator/backend test:coverage",
    "test": "pnpm -r test",
    "test:int": "bash scripts/test-int.sh",
    "test:e2e": "playwright test",
    "docs:screenshots": "playwright test -c playwright.ui-tour.config.ts",
    "dex:up": "bash scripts/dex-up.sh",
    "dex:down": "bash scripts/dex-down.sh",
    "kind:up": "bash scripts/kind-up.sh",
    "kind:down": "bash scripts/kind-down.sh",
    "crds:install": "bash scripts/crds-install.sh",
    "versions:report": "bash scripts/versions-report.sh",
    "templates:generate": "pnpm --filter @capi-navigator/shared build && node packages/shared/dist/cluster/templates/generate-cli.js",
    "versions:generate": "pnpm --filter @capi-navigator/shared build && node packages/shared/dist/versions/generate-cli.js",
    "openapi:generate": "pnpm --filter @capi-navigator/backend build && node apps/backend/dist/openapi/generate-cli.js",
    "crds:generate": "pnpm --filter @capi-navigator/shared build && node packages/shared/dist/crds/generate-cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vue-eslint-parser": "^10.3.0"
  }
}

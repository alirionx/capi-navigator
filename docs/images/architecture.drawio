          <mxGeometry x="205" y="38" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="osb" value="&lt;b&gt;Open Service Broker&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;color:#555555'&gt;separate project, uses blueprints&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fontFamily=Helvetica;fontColor=#1f1f1f;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="clients">

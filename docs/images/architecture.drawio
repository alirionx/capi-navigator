<mxfile host="capi-navigator">
  <diagram name="Overview" id="overview">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1110" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;CAPI Navigator – technical overview&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontFamily=Helvetica;fontColor=#1f1f1f;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1640" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The app writes standard Cluster API resources. The controllers in the management cluster do the actual work: VMs, Kubernetes, add-ons." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1640" height="22" as="geometry" />
        </mxCell>
        <mxCell id="clients" value="Clients" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;fontStyle=1;fontFamily=Helvetica;fontColor=#1f1f1f;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
